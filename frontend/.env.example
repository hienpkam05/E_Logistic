# Sao chép thành frontend/.env. Không commit file .env.

# Tiền tố API mà trình duyệt gọi. Giữ đường dẫn tương đối khi chạy qua proxy Vite hoặc reverse proxy.
VITE_API_BASE_URL=/api/v1

# Chỉ dùng khi chạy `npm run dev`: Vite chuyển tiếp /api tới địa chỉ Django này.
VITE_PROXY_TARGET=http://127.0.0.1:8000

# Thông tin liên hệ ở trang Quên mật khẩu, vd "Hotline điều phối 0900 000 000". Để trống: "Liên hệ Nhân viên HTT Express".
VITE_SUPPORT_CONTACT=

# Chu kỳ (mili giây) cập nhật số thông báo chưa đọc. Mặc định 60000.
VITE_NOTIFICATION_POLL_MS=60000

# Bỏ trống cả hai: nền OSM mặc định. Provider riêng phải khai báo cả URL và attribution HTML tin cậy.
# Không đặt token bí mật tại VITE_* (giá trị được đóng gói vào trình duyệt).
VITE_MAP_TILE_URL=
VITE_MAP_TILE_ATTRIBUTION=
