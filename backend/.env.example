# Sao chép thành backend/.env rồi chỉnh giá trị. Không commit file .env.

# Django
# Tạo khóa mới: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=change-me-to-a-random-secret-key
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Origin được tin cậy cho CSRF, phân tách bằng dấu phẩy (vd https://htt.example.com). Để trống khi chạy local qua proxy Vite.
DJANGO_CSRF_TRUSTED_ORIGINS=

# Phiên đăng nhập: số giây tới khi hết hạn (mặc định 8 giờ = 28800).
DJANGO_SESSION_AGE_SECONDS=28800
# True khi chạy HTTPS: cookie phiên/CSRF chỉ gửi qua HTTPS.
DJANGO_SECURE_COOKIES=False
# Giới hạn gọi đăng nhập mỗi IP (định dạng DRF: 10/min, 100/hour…).
DJANGO_LOGIN_RATE=10/min
# Giới hạn gọi đổi mật khẩu mỗi tài khoản.
DJANGO_PASSWORD_CHANGE_RATE=10/min

# PostgreSQL — Django và Docker Compose dùng chung file này:
#   docker compose --env-file backend/.env up -d db
# Đổi POSTGRES_PORT (vd 5433) nếu máy đã có PostgreSQL khác chiếm cổng 5432.
POSTGRES_DB=htt_express
POSTGRES_USER=htt_express
POSTGRES_PASSWORD=htt_local_password
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
