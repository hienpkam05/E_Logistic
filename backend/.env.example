# Sao chép thành backend/.env rồi chỉnh giá trị. Không commit file .env.

# Django
# Tạo khóa mới: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=change-me-to-a-random-secret-key
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# PostgreSQL — phải khớp với compose.yaml khi chạy database bằng Docker Compose
POSTGRES_DB=htt_express
POSTGRES_USER=htt_express
POSTGRES_PASSWORD=htt_local_password
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
